# Copy to .env and change the values.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:8000
# Local run (no Docker) uses SQLite by default. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./onboarding.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
# Email: leave SMTP_HOST empty to only log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.com
# Set true ONLY for local development (returns reset/verify tokens in API responses).
DEBUG_RETURN_TOKENS=false
# Minutes between automatic overdue-task reminder runs. 0 = off.
REMINDER_INTERVAL_MINUTES=60
# Optional: creates a platform (SaaS operator) admin at startup.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
